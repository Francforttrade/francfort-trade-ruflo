# Google Cloud
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
GCP_SERVICE_ACCOUNT_KEY=

# Supabase PostgreSQL
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Anthropic API
ANTHROPIC_API_KEY=

# WhatsApp / Communications
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# Searates (Shipping)
SEARATES_API_KEY=

# Google Sheets
GOOGLE_SHEETS_TRACKING_ID=
GOOGLE_SHEETS_FOLDER_ID=

# Webhook auth (Apps Script Gmail sync, WhatsApp) — see src/middleware/webhookAuth.js
WEBHOOK_SHARED_SECRET=

# Payment tracking — arrival/collection alerts (docs/PAGAMENTOS_TRACKING.md)
TIMEZONE=America/Sao_Paulo
ALERT_DAYS_BEFORE=7
ALERT_EXTRA_RECIPIENTS=
PAYMENT_TRACKING_TEST_MODE=false

# Google Calendar (payment tracking events) — service account with
# domain-wide delegation, impersonating export@francfort.co
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=

# Outbound email (internal alerts only — never to a buyer)
EMAIL_SMTP_HOST=
EMAIL_FROM_ADDRESS=

# Digitalizacao (document classification/extraction) — src/agents/digitalizacao/
# 4-band confidence policy, docs/RDIA_PRD.md §13.
DIGITALIZACAO_CONFIDENCE_AUTO_ACCEPT=0.95
DIGITALIZACAO_CONFIDENCE_ACCEPT_FLAGGED=0.80
DIGITALIZACAO_CONFIDENCE_REVIEW_REQUIRED=0.60
# PaddleOCR worker (services/paddleocr/) — a private Cloud Run service, no
# API key needed: auth is IAM/OIDC via the main service's own identity (see
# docs/RDIA_PRD.md section F and docs/DEPLOY.md).
PADDLE_OCR_SERVICE_URL=
DIGITALIZACAO_OCR_TIMEOUT_MS=30000
DIGITALIZACAO_OCR_MIN_CONFIDENCE=0.5
DIGITALIZACAO_CACHE_TTL_DAYS=90
DIGITALIZACAO_MAX_PAID_CALLS_PER_FTR=20
DIGITALIZACAO_MAX_PAID_CALLS_PER_DAY=500
# Google Document AI (fallback "expensive" tier, chunk 2b) — usa as mesmas
# credenciais do Firestore/Supabase (roles/documentai.apiUser na service
# account), sem API key própria. Ver docs/DEPLOY.md item 8.
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us
DIGITALIZACAO_DOCUMENT_AI_MIN_CONFIDENCE=0.5

# Environment
NODE_ENV=development
PORT=3000
