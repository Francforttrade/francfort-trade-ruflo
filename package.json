{
  "name": "francfort-trade-ruflo",
  "version": "1.0.0",
  "description": "Ruflo - Multi-agent export automation system for Francfort Trade",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "lint": "eslint src/**/*.js test/**/*.js server.js",
    "format": "prettier --write src/**/*.js test/**/*.js server.js"
  },
  "keywords": [
    "ruflo",
    "export",
    "agents",
    "francfort",
    "trade",
    "automation",
    "orchestration"
  ],
  "author": "Francfort Trade",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@supabase/supabase-js": "^2.26.0",
    "axios": "^1.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.4.1",
    "joi": "^17.9.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "winston": "^3.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "eslint": "^8.40.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.0"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/test/jestSetup.js"
    ]
  }
}
