        "description_goods": "Peanuts 38/42 Grade, 25kg bags",
        "bl_date": "2026-08-25",
        "onboard_date": "2026-08-25",
        "bl_status": "Issued"
      }
    },

    "Compliance": {
      "description": "Registro de conformidades regulatórias por FTR",
      "properties": {
        "compliance_id": { "type": "string", "pattern": "^CMP-[0-9]{6}-[0-9]{2}$" },
        "ftr_code": { "type": "string" },
        "market": { "type": "string" },
        "required_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document_type": { "type": "string", "enum": ["ACID", "Import Permit", "Phyto", "Fumigation", "Aflatoxin", "Quality", "CO"] },
              "status": { "type": "string", "enum": ["Pending", "Obtained", "Expired", "Failed"] },
              "expiry_date": { "type": "string", "format": "date" },
              "issued_by": { "type": "string" },
              "reference_number": { "type": "string" }
            }
          }
        },
        "aflatoxin": {
          "type": "object",
          "properties": {
            "limit_ppb": { "type": "number", "description": "5/10 Russia, 2/4 EU" },
            "lab_result_ppb": { "type": "number" },
            "lab_name": { "type": "string" },
            "test_date": { "type": "string", "format": "date" },
            "result_status": { "type": "string", "enum": ["Pass", "Fail", "Pending"] }
          }
        },
        "quality_approval": {
          "type": "object",
          "properties": {
            "buyer_approved": { "type": "boolean" },
            "approval_date": { "type": "string", "format": "date" },
            "approved_by": { "type": "string" }
          }
        },
        "alert_calendar": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document": { "type": "string" },
              "expiry_date": { "type": "string", "format": "date" },
              "days_until_expiry": { "type": "number" },
              "alert_sent": { "type": "boolean" }
            }
          },
          "description": "Alertas de vencimento para renovação"
        },
        "created_date": { "type": "string", "format": "date-time" },
        "updated_date": { "type": "string", "format": "date-time" }
      },
      "required": ["compliance_id", "ftr_code", "market"],
      "example": {
        "compliance_id": "CMP-030075-26",
        "ftr_code": "03075-26",
        "market": "Algeria",
        "required_documents": [
          {
            "document_type": "ACID",
            "status": "Obtained",
            "expiry_date": "2026-09-01",
            "issued_by": "SARL Tassali",
            "reference_number": "ACID-2026-001"
          },
          {
            "document_type": "Phyto",
            "status": "Pending",
            "expiry_date": "2026-10-15"
          }
        ],
        "aflatoxin": {
          "limit_ppb": 5,
          "lab_result_ppb": 3.5,
          "lab_name": "Eurofins",
          "test_date": "2026-08-15",
          "result_status": "Pass"
        },
        "quality_approval": {
          "buyer_approved": true,
          "approval_date": "2026-08-18",
          "approved_by": "ahmed@tassali.dz"
        }
      }
    },

    "Payment": {
      "description": "Registro de pagamento e comprovação de crédito",
      "properties": {
        "payment_id": { "type": "string", "pattern": "^PAY-[0-9]{6}-[0-9]{2}$" },
        "ftr_code": { "type": "string" },
        "invoice_number": { "type": "string" },
        "amount_usd": { "type": "number" },
        "payment_type": { "type": "string", "enum": ["Advance", "Main", "Partial"] },
        "payment_method": { "type": "string", "enum": ["SWIFT", "LC", "CAD", "Check"] },
        "swift_details": {
          "type": "object",
          "properties": {
            "swift_reference": { "type": "string" },
            "sending_bank": { "type": "string" },
            "receiving_bank": { "type": "string" },
            "sent_date": { "type": "string", "format": "date" },
            "received_date": { "type": "string", "format": "date" }
          }
        },
        "bank_credit_confirmation": {
          "type": "object",
          "properties": {
            "confirmed": { "type": "boolean" },
            "confirmation_date": { "type": "string", "format": "date" },
            "confirmation_method": { "type": "string", "enum": ["Bank Statement", "Email from Bank", "Portal Check"] },
            "bank_statement_ref": { "type": "string" }
          },
          "description": "Obrigatório antes de liberar docs CAD"
        },
        "original_documents_released": {
          "type": "object",
          "properties": {
            "released": { "type": "boolean" },
            "release_date": { "type": "string", "format": "date" },
            "courier_company": { "type": "string" },
            "tracking_number": { "type": "string" }
          }
        },
        "payment_status": {
          "type": "string",
          "enum": ["Pending", "In Transit", "Received", "Cleared", "Disputed"],
          "descriptio